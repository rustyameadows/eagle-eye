    },
    {
      "from": "sites",
      "to": "site-detail",
      "checks": ["legend-gap", "legend-gap-control"]
    },
    {
      "from": "observations",
      "to": "observation-detail",
      "checks": ["header-inset", "header-inset-control"]
    },
    {
      "from": "calendar",
      "to": "itinerary",
