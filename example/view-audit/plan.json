  "anchors": {
    "pane": "main",
    "title": "h1",
    "tools": ".toolbar",
    "workspace": ".workspace",
    "first-row": ".entry:first-child",
    "name": ".entry:first-child .name",
    "header": ".bar",
    "tree-label": ".tree-label",
    "tree-row": ".tree-row",
    "query-text": ".query-text",
    "query-box": ".query-box",
    "tag-label": ".tag-label",
    "tag-swatch": ".tag-swatch",
    "legend-label": ".legend-label",
    "legend-key": ".legend-key",
    "column-label": ".column-label",
    "column-head": ".column-head",
    "day-number": ".day-number",
    "date-badge": ".date-badge",
    "person-name": ".person-name",
    "person-avatar": ".person-avatar",
    "event-dot": ".event-dot",
    "event-list": ".event-list",
    "field-hint": ".field-hint",
    "field-group": ".field-group",
    "foot-action": ".foot-action",
    "panel-foot": ".panel-foot"
  },
  "checks": {
    "pane-left": {
      "label": "Content pane edge",
      "point": ["pane", "left"],
      "tolerance": 0.25
    },
    "title-left": {
      "label": "Title start",
      "point": ["title", "left"],
      "tolerance": 0.25
    },
    "title-inset": {
      "label": "Title inset within pane",
      "point": ["title", "left"],
      "relativeTo": ["pane", "left"],
      "tolerance": 0.25
    },
    "row-inset": {
      "label": "First label inset within row",
      "point": ["name", "left"],
      "relativeTo": ["first-row", "left"],
      "tolerance": 0.25
    },
    "toolbar-gap": {
      "label": "Title to toolbar gap",
      "point": ["tools", "top"],
      "relativeTo": ["title", "bottom"],
      "tolerance": 0.25
    },
    "action-right": {
      "label": "Workspace link trailing edge",
      "point": ["workspace", "right"],
      "tolerance": 0.25
    },
    "title-top": {
      "label": "Title top",
      "point": ["title", "top"],
      "tolerance": 0.25
    },
    "workspace-center": {
      "label": "Workspace link vertical alignment",
      "point": ["workspace", "centerY"],
      "relativeTo": ["header", "centerY"],
      "tolerance": 0.25
    },
    "tree-inset": {
      "label": "Folder label inset",
      "point": ["tree-label", "left"],
      "relativeTo": ["tree-row", "left"],
      "tolerance": 0.25
    },
    "tree-inset-control": {
      "label": "Folder label top inset",
      "point": ["tree-label", "top"],
      "relativeTo": ["tree-row", "top"],
      "tolerance": 0.25
    },
    "query-inset": {
      "label": "Search text inset",
      "point": ["query-text", "left"],
      "relativeTo": ["query-box", "left"],
      "tolerance": 0.25
    },
    "query-inset-control": {
      "label": "Search text top inset",
      "point": ["query-text", "top"],
      "relativeTo": ["query-box", "top"],
      "tolerance": 0.25
    },
    "chip-gap": {
      "label": "Tag swatch to label gap",
      "point": ["tag-label", "left"],
      "relativeTo": ["tag-swatch", "right"],
      "tolerance": 0.25
    },
    "chip-gap-control": {
      "label": "Tag label vertical position",
      "point": ["tag-label", "top"],
      "relativeTo": ["tag-swatch", "top"],
      "tolerance": 0.25
    },
    "legend-gap": {
      "label": "Legend key to label gap",
      "point": ["legend-label", "left"],
      "relativeTo": ["legend-key", "right"],
      "tolerance": 0.25
    },
    "legend-gap-control": {
      "label": "Legend label vertical position",
      "point": ["legend-label", "top"],
      "relativeTo": ["legend-key", "top"],
      "tolerance": 0.25
    },
    "header-inset": {
      "label": "Table heading inset",
      "point": ["column-label", "left"],
      "relativeTo": ["column-head", "left"],
      "tolerance": 0.25
    },
    "header-inset-control": {
      "label": "Table heading top inset",
      "point": ["column-label", "top"],
      "relativeTo": ["column-head", "top"],
      "tolerance": 0.25
    },
    "day-inset": {
      "label": "Day number top inset",
      "point": ["day-number", "top"],
      "relativeTo": ["date-badge", "top"],
      "tolerance": 0.25
    },
    "day-inset-control": {
      "label": "Day number left inset",
      "point": ["day-number", "left"],
      "relativeTo": ["date-badge", "left"],
      "tolerance": 0.25
    },
    "avatar-gap": {
      "label": "Avatar to name gap",
      "point": ["person-name", "left"],
      "relativeTo": ["person-avatar", "right"],
      "tolerance": 0.25
    },
    "avatar-gap-control": {
      "label": "Name vertical position",
      "point": ["person-name", "top"],
      "relativeTo": ["person-avatar", "top"],
      "tolerance": 0.25
    },
    "marker-inset": {
      "label": "Event marker inset",
      "point": ["event-dot", "left"],
      "relativeTo": ["event-list", "left"],
      "tolerance": 0.25
    },
    "marker-inset-control": {
      "label": "Event marker top inset",
      "point": ["event-dot", "top"],
      "relativeTo": ["event-list", "top"],
      "tolerance": 0.25
    },
    "hint-inset": {
      "label": "Field hint inset",
      "point": ["field-hint", "left"],
      "relativeTo": ["field-group", "left"],
      "tolerance": 0.25
    },
    "hint-inset-control": {
      "label": "Field hint top inset",
      "point": ["field-hint", "top"],
      "relativeTo": ["field-group", "top"],
      "tolerance": 0.25
    },
    "footer-inset": {
      "label": "Footer action trailing inset",
      "point": ["foot-action", "right"],
      "relativeTo": ["panel-foot", "right"],
      "tolerance": 0.25
    },
    "footer-inset-control": {
      "label": "Footer action top inset",
      "point": ["foot-action", "top"],
      "relativeTo": ["panel-foot", "top"],
      "tolerance": 0.25
    }
  },
  "pairs": [
    {
      "from": "inbox",
      "to": "archive",
      "checks": ["title-inset", "title-left", "row-inset", "pane-left", "toolbar-gap", "action-right", "workspace-center"]
    },
    {
      "from": "inbox",
      "to": "record",
      "checks": ["toolbar-gap", "title-top", "title-inset", "pane-left", "action-right", "workspace-center"],
      "expect": {
        "title-top": {
          "delta": 32,
          "reason": "The record view adds a 32 CSS px breadcrumb above the title."
        }
      }
    },
    {
      "from": "inbox",
      "to": "settings",
      "checks": ["pane-left", "title-left", "title-inset", "action-right", "workspace-center"]
    },
    {
      "from": "archive",
      "to": "inbox",
      "checks": ["title-inset", "row-inset"]
    },
    {
      "from": "inbox",
      "to": "returned-inbox",
      "checks": ["title-inset", "action-right", "workspace-center"]
    },
    {
      "from": "archive",
      "to": "returned-inbox",
      "checks": ["title-inset"]
    },
    {
      "from": "collections",
      "to": "collection-detail",
      "checks": ["tree-inset", "tree-inset-control"]
    },
    {
      "from": "search",
