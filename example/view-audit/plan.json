    },
    {
      "from": "inbox",
      "to": "observations",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
      "to": "calendar",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
      "to": "team",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
      "to": "activity",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
      "to": "preferences",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
