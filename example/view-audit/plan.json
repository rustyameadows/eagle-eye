    },
    {
      "from": "preferences",
      "to": "new-note",
      "checks": ["hint-inset", "hint-inset-control"]
    },
    {
      "from": "review",
      "to": "imports",
      "checks": ["footer-inset", "footer-inset-control"]
    },
    {
      "from": "inbox",
      "to": "collections",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
      "to": "search",
      "checks": ["title-inset", "toolbar-gap", "workspace-center"]
    },
    {
      "from": "inbox",
